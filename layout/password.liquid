<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <meta name="description" content="{{ 'general.meta.tagline' | t }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="hero" style="min-height:100vh;background-color:var(--color-accent-dark);background-image:none;">
    <div class="hero__content" style="max-width:520px;text-align:center;margin:0 auto;">
      <span class="eyebrow hero__eyebrow">{{ 'general.password_page.opening_soon' | t }}</span>
      <h1>{{ shop.name }}</h1>
      <p>{{ shop.password_message | default: ('general.meta.tagline' | t) }}</p>

      {{ content_for_layout }}

      {% form 'storefront_password' %}
        {%- if form.errors -%}
          <p style="color:#ffb4b4;">{{ 'general.password_page.login_form_error' | t }}</p>
        {%- endif -%}
        <div class="newsletter-form">
          <input type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}" required>
          <button type="submit">{{ 'general.password_page.login_password_button' | t }}</button>
        </div>
      {% endform %}

      <p style="margin-top:24px;font-size:13px;opacity:0.8;">{{ 'general.password_page.admin_link_html' | t }}</p>
    </div>
  </div>
</body>
</html>
