<section class="section">
  <div class="page-width">
    <div class="page-banner" style="padding-top:0;">
      <span class="eyebrow">Get in touch</span>
      <h1>{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}
        <p style="max-width:520px;margin:12px auto 0;color:#6b6259;">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="text-align:center;margin-bottom:24px;">{{ 'contact.form.success' | t }}</p>
      {%- endif -%}

      <div class="contact-form">
        <div class="field">
          <label for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}">
        </div>
        <div class="field">
          <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
        </div>
        <div class="field">
          <label for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}">
        </div>
        <div class="field">
          <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactMessage" name="contact[body]" rows="6">{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn">{{ 'contact.form.send' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
