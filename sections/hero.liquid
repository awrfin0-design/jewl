<div
  class="hero"
  style="background-image:url('{{ section.settings.image | image_url: width: 2000 }}');"
>
  <div class="hero__content">
    <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading | default: ('sections.hero.default_heading' | t) }}</h1>
    <p>{{ section.settings.subheading | default: ('sections.hero.default_subheading' | t) }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--light">
        {{ section.settings.button_label | default: ('sections.hero.default_button' | t) }}
      </a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--light">{{ 'sections.hero.default_button' | t }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
