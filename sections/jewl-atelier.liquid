<div class="jewl">
  <section class="j-block j-band-sec" id="atelier">
    <div class="j-wrap j-story">
      <div>
        <div class="j-eyebrow">{{ 'jewl.a_eyebrow' | t }}</div>
        <blockquote>
          <span>{{ 'jewl.a_quote_html' | t }}</span>
          <cite>{{ 'jewl.a_cite' | t }}</cite>
        </blockquote>
      </div>
      <div class="j-atelier-side">
        <div class="j-ph j-has-img j-atelier-img" data-stone="aqua" data-metal="yellow">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt, sizes: '(min-width: 860px) 45vw, 100vw' }}
          {%- else -%}
            <img src="{{ 'jewl-atelier.jpg' | asset_img_url: '1400x' }}" alt="{{ 'jewl.a_cite' | t | escape }}" loading="lazy" width="1400" height="788">
          {%- endif -%}
        </div>
      <div class="j-facts">
        <div><b class="j-num j-gild">100%</b><span>{{ 'jewl.f1' | t }}</span></div>
        <div><b class="j-num j-gild">7</b><span>{{ 'jewl.f2' | t }}</span></div>
        <div><b class="j-num j-gild">{{ 'jewl.f3v' | t }}</b><span>{{ 'jewl.f3' | t }}</span></div>
      </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jewl atelier",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Atelier photo", "info": "Leave empty to use the Jewl atelier photo." }
  ],
  "presets": [{ "name": "Jewl atelier" }]
}
{% endschema %}
