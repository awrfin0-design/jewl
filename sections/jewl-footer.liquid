{%- liquid
  assign wordmark = settings.jewl_wordmark | default: 'Jewl'
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}
<div class="jewl">
  <footer class="j-site">
    <div class="j-wrap">
      <div class="j-foot">
        <div>
          <div class="j-logo j-gild">{{ wordmark }}</div>
          <p style="max-width:34ch;margin:10px 0 0">
            {%- if section.settings.about != blank -%}{{ section.settings.about }}{%- else -%}{{ 'jewl.ft_about' | t }}{%- endif -%}
          </p>
        </div>
        <div>
          <h4>{{ 'jewl.ft_shop' | t }}</h4>
          <ul>
            {%- if section.settings.shop_menu != blank and section.settings.shop_menu.links.size > 0 -%}
              {%- for link in section.settings.shop_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            {%- else -%}
              <li><a href="{{ root }}/#shop" data-j-go="rings">{{ 'jewl.rings' | t }}</a></li>
              <li><a href="{{ root }}/#shop" data-j-go="necklaces">{{ 'jewl.necklaces' | t }}</a></li>
              <li><a href="{{ root }}/#shop" data-j-go="earrings">{{ 'jewl.earrings' | t }}</a></li>
              <li><a href="{{ root }}/#shop" data-j-go="bracelets">{{ 'jewl.bracelets' | t }}</a></li>
            {%- endif -%}
          </ul>
        </div>
        <div>
          <h4>{{ 'jewl.ft_care' | t }}</h4>
          <ul>
            {%- if section.settings.care_menu != blank and section.settings.care_menu.links.size > 0 -%}
              {%- for link in section.settings.care_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            {%- else -%}
              {%- assign care_pages = 'ring-size-guide,lifetime-resizing,shipping-returns,jewelry-care' | split: ',' -%}
              {%- assign care_keys = 'jewl.ft_size,jewl.ft_resize,jewl.ft_ship,jewl.ft_carejw' | split: ',' -%}
              {%- for handle in care_pages -%}
                {%- assign care_page = pages[handle] -%}
                {%- assign care_key = care_keys[forloop.index0] -%}
                {%- if care_page.handle != blank -%}
                  <li><a href="{{ care_page.url }}">{{ care_key | t }}</a></li>
                {%- elsif handle == 'ring-size-guide' -%}
                  <li><a href="{{ root }}/#engrave">{{ care_key | t }}</a></li>
                {%- endif -%}
              {%- endfor -%}
              {%- if pages.contact.handle != blank -%}
                <li><a href="{{ pages.contact.url }}">{{ pages.contact.title }}</a></li>
              {%- endif -%}
            {%- endif -%}
          </ul>
        </div>
        <div>
          <h4>{{ 'jewl.ft_visit' | t }}</h4>
          <ul>
            {%- assign address_lines = section.settings.address | newline_to_br | split: '<br />' -%}
            {%- for address_line in address_lines -%}
              {%- assign address_line_clean = address_line | strip -%}
              {%- if address_line_clean != blank -%}<li>{{ address_line_clean }}</li>{%- endif -%}
            {%- endfor -%}
            <li>{% if section.settings.hours != blank %}{{ section.settings.hours }}{% else %}{{ 'jewl.ft_hours' | t }}{% endif %}</li>
            {%- if section.settings.email != blank -%}<li>{{ section.settings.email }}</li>{%- endif -%}
          </ul>
        </div>
      </div>
      <div class="j-legal">
        <span>© {{ 'now' | date: '%Y' }} {{ section.settings.legal_name }}</span>
        <span>{{ powered_by_link }}</span>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Jewl footer",
  "class": "jewl-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "info": "Leave empty to use the translated default." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop column menu", "info": "Leave empty to show Rings, Necklaces, Earrings and Bracelets." },
    { "type": "link_list", "id": "care_menu", "label": "Care column menu", "info": "Leave empty to link the pages with the handles ring-size-guide, lifetime-resizing, shipping-returns, jewelry-care and contact, when they exist." },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Rua da Rosa 112\n1200-389 Lisboa" },
    { "type": "text", "id": "hours", "label": "Opening hours", "info": "Leave empty to use the translated default." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@jewl.example" },
    { "type": "text", "id": "legal_name", "label": "Company name", "default": "Jewl Joalharia, Lda." }
  ],
  "presets": [{ "name": "Jewl footer" }]
}
{% endschema %}
