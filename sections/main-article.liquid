<article class="section">
  <div class="page-width" style="max-width:760px;">
    <div class="page-banner" style="padding-top:0;">
      <span class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</span>
      <h1>{{ article.title }}</h1>
    </div>
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="margin-bottom:32px;" loading="lazy">
    {%- endif -%}
    <div>{{ article.content }}</div>

    <p style="margin-top:48px;"><a href="{{ blog.url }}">&larr; Back to {{ blog.title }}</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article page", "settings": [] }
{% endschema %}
