<section class="section">
  <div class="page-width">
    <div class="contact-form">
      <div class="page-banner" style="padding-top:0;">
        <h1>Create account</h1>
      </div>
      {% form 'create_customer' %}
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="RegisterFirstName">First name</label>
          <input type="text" id="RegisterFirstName" name="customer[first_name]">
        </div>
        <div class="field">
          <label for="RegisterLastName">Last name</label>
          <input type="text" id="RegisterLastName" name="customer[last_name]">
        </div>
        <div class="field">
          <label for="RegisterEmail">{{ 'contact.form.email' | t }}</label>
          <input type="email" id="RegisterEmail" name="customer[email]" required>
        </div>
        <div class="field">
          <label for="RegisterPassword">Password</label>
          <input type="password" id="RegisterPassword" name="customer[password]" required>
        </div>
        <button type="submit" class="btn" style="width:100%;">Create account</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Register page", "settings": [] }
{% endschema %}
