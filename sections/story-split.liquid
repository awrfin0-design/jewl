<section class="section">
  <div class="page-width">
    <div class="split{% if section.settings.image_position == 'right' %} split--reverse{% endif %}">
      {%- if section.settings.image_position == 'right' -%}
        <div class="split__content">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.text }}</p>
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
        <div>
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div>
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="split__content">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h2>{{ section.settings.heading }}</h2>
          <p>{{ section.settings.text }}</p>
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story (image + text)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted with intention" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Story (image + text)" }
  ]
}
{% endschema %}
