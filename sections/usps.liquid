<section class="section section--tight">
  <div class="page-width">
    <div class="section__header">
      <h2>{{ section.settings.heading | default: ('sections.usps.heading' | t) }}</h2>
    </div>
    <div class="usp-grid">
      {%- for block in section.blocks -%}
        <div class="usp-item" {{ block.shopify_attributes }}>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "USPs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USPs",
      "blocks": [
        { "type": "usp", "settings": { "title": "Lifetime warranty", "text": "Every piece is covered, forever." } },
        { "type": "usp", "settings": { "title": "Ethically sourced", "text": "Conflict-free diamonds and recycled gold." } },
        { "type": "usp", "settings": { "title": "Free shipping & returns", "text": "On all orders over $150." } },
        { "type": "usp", "settings": { "title": "Handcrafted in-house", "text": "Made by master jewelers." } }
      ]
    }
  ]
}
{% endschema %}
