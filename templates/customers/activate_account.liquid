<section class="section">
  <div class="page-width">
    <div class="contact-form">
      <div class="page-banner" style="padding-top:0;">
        <h1>Activate account</h1>
      </div>
      {% form 'activate_customer_password' %}
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="ActivatePassword">Password</label>
          <input type="password" id="ActivatePassword" name="customer[password]" required>
        </div>
        <div class="field">
          <label for="ActivatePasswordConfirm">Confirm password</label>
          <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" required>
        </div>
        <button type="submit" class="btn" style="width:100%;">Activate account</button>
      {% endform %}
    </div>
  </div>
</section>
