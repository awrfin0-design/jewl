<section class="section">
  <div class="page-width">
    <div class="page-banner" style="padding-top:0;">
      <h1>Order {{ order.name }}</h1>
      <p style="color:#6b6259;">Placed on {{ order.created_at | date: '%B %d, %Y' }}</p>
    </div>

    <table class="cart-table">
      <thead>
        <tr><th>Product</th><th>{{ 'general.cart.quantity' | t }}</th><th>Total</th></tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="cart-summary">
      <div class="cart-summary__row"><span>{{ 'general.cart.subtotal' | t }}</span><strong>{{ order.total_price | money }}</strong></div>
    </div>

    <p style="margin-top:32px;"><a href="{{ routes.account_url }}">&larr; Back to account</a></p>
  </div>
</section>
