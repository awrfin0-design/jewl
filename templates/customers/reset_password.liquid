<section class="section">
  <div class="page-width">
    <div class="contact-form">
      <div class="page-banner" style="padding-top:0;">
        <h1>Reset password</h1>
      </div>
      {% form 'reset_customer_password' %}
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="ResetPassword">New password</label>
          <input type="password" id="ResetPassword" name="customer[password]" required>
        </div>
        <div class="field">
          <label for="ResetPasswordConfirm">Confirm new password</label>
          <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" required>
        </div>
        <button type="submit" class="btn" style="width:100%;">Reset password</button>
      {% endform %}
    </div>
  </div>
</section>
